function scr_gun_pickup(_damage, _reload_time, _spr, _magazine, _bull_magazine, _ammo, _bullet, _obj) constructor {
    damage = _damage;
    reload_time = _reload_time;
    spr = _spr;
    magazine = _magazine;
    bull_magazine = _bull_magazine; // bullets in magazine
    ammo = _ammo;
    bullet = _bullet;
    obj = _obj;
}